+            Ok(StartedExecution {
+                request_id: gateway_core::engine::ModelRequestId::new("req_native_image_bridge")
+                    .unwrap(),
+                created_at: std::time::SystemTime::now(),
+                stream: false,
+                session: Box::new(NativeImageSession {
+                    response: Some(self.response.clone()),
+                    commits: self.commits.clone(),
+                    finalized: AtomicBool::new(false),
+                }),
+            })
+        })
+    }
+}
