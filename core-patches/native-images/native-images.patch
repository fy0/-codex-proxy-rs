+struct NativeImageSession {
+    response: Option<bytes::Bytes>,
+    commits: Arc<AtomicUsize>,
+    finalized: AtomicBool,
+}
+
+impl gateway_core::engine::execution::ExecutionSession for NativeImageSession {
+    fn next_event(
+        &mut self,
+    ) -> BoxFuture<
+        '_,
+        Result<Option<gateway_core::engine::CoordinatedEvent>, gateway_core::engine::EngineError>,
+    > {
+        panic!("原生 JSON 交付不走 Responses SSE")
+    }
+
+    fn collect_uncommitted(
+        &mut self,
+    ) -> BoxFuture<
+        '_,
+        Result<Vec<gateway_core::event::ProviderEvent>, gateway_core::engine::EngineError>,
+    > {
+        let response = self.response.take().expect("单次读取原生响应");
+        Box::pin(async move {
+            Ok(vec![gateway_core::event::ProviderEvent::wire(
+                gateway_core::event::ProtocolWireEvent::raw_json("openai", response).unwrap(),
+            )])
+        })
+    }
+
+    fn response_headers(&self) -> &[gateway_core::event::ProviderResponseHeader] {
+        &[]
+    }
+
+    fn commit_downstream(
+        &mut self,
+        status: Option<u16>,
+    ) -> BoxFuture<'_, Result<(), gateway_core::engine::EngineError>> {
+        Box::pin(async move {
+            assert_eq!(status, Some(200));
+            assert!(!self.finalized.swap(true, Ordering::SeqCst));
+            self.commits.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        })
+    }
+
+    fn record_client_status(
+        &mut self,
+        _: u16,
+    ) -> BoxFuture<'_, Result<(), gateway_core::engine::EngineError>> {
+        Box::pin(async { Ok(()) })
+    }
+
+    fn is_finalized(&self) -> bool {
+        self.finalized.load(Ordering::SeqCst)
+    }
+
+    fn cancel(&self) {
+        self.finalized.store(true, Ordering::SeqCst);
+    }
+
+    fn detach_finalize(self: Box<Self>) -> BoxFuture<'static, ()> {
+        Box::pin(async move { self.finalized.store(true, Ordering::SeqCst) })
+    }
+}
