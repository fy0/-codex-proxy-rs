+}
+
+impl MiddlewarePlan for NativeImageMiddleware {
+    fn handle(
+        &self,
+        _: MiddlewareContext,
+        request: MiddlewareRequest,
+        next: MiddlewareNext,
+    ) -> BoxFuture<'static, Result<MiddlewareResponse, MiddlewareError>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.deny {
