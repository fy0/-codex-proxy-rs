+// 原生 Images 管理桥只改变入口身份，不引入第二套执行或结算。
+struct NativeImageExecution {
+    captured: Mutex<Vec<bytes::Bytes>>,
+    turn_ids: Mutex<Vec<String>>,
+    request_ids: Mutex<Vec<String>>,
+    response: bytes::Bytes,
+    prepared: AtomicUsize,
+    middleware_calls: Arc<AtomicUsize>,
+    commits: Arc<AtomicUsize>,
+    deny_middleware: bool,
+}
+
+impl NativeImageExecution {
+    fn new(deny_middleware: bool) -> Arc<Self> {
+        Arc::new(Self {
+            captured: Mutex::new(Vec::new()),
+            turn_ids: Mutex::new(Vec::new()),
+            request_ids: Mutex::new(Vec::new()),
+            response: bytes::Bytes::from(format!(
+                "{{ \"created\":1787212800, \"data\":[{{\"b64_json\":\"{}\"}}], \"future\":9007199254740993 }}",
+                "A".repeat(2 * 1024 * 1024)
+            )),
+            prepared: AtomicUsize::new(0),
+            middleware_calls: Arc::default(),
+            commits: Arc::default(),
+            deny_middleware,
+        })
+    }
+}
+
+impl ExecutionService for NativeImageExecution {
+    fn authenticate(&self, _: &str) -> Result<AuthenticatedClient, ClientAuthenticationError> {
+        panic!("原生 Images 管理桥不能把管理身份当作 Client Key")
+    }
+
+    fn public_models(&self, _: &AuthenticatedClient) -> Vec<PublicModelId> {
+        Vec::new()
+    }
+
+    fn contains_public_model(&self, _: &AuthenticatedClient, _: &PublicModelId) -> bool {
+        false
+    }
+
+    fn prepare_plugin_execution(
+        &self,
+        key: &ClientApiKeyId,
+    ) -> BoxFuture<'_, Result<PreparedRootExecution, GatewayError>> {
+        let allowed = key.as_str() == "client-key";
+        Box::pin(async move {
+            if !allowed {
+                return Err(GatewayError::new(
+                    gateway_core::error::GatewayErrorKind::PolicyDenied,
+                    "fixture client key denied",
+                ));
+            }
+            self.prepared.fetch_add(1, Ordering::SeqCst);
+            let prepared = self
+                .prepare_execution(crate::openai::authenticated_client("fixture-native-key"))
+                .await?;
+            self.request_ids
+                .lock()
+                .unwrap()
+                .push(prepared.request_id().as_str().to_owned());
+            Ok(prepared)
+        })
+    }
+
+    fn middleware_plan(&self, _: &PreparedRootExecution) -> Option<FrozenMiddlewarePlan> {
+        Some(FrozenMiddlewarePlan::new(
+            Arc::new(NativeImageMiddleware {
+                calls: self.middleware_calls.clone(),
+                deny: self.deny_middleware,
+            }),
+            ExtensionSetReference::new(
+                ExtensionSetId::new("native-image-bridge-test".into()).unwrap(),
+                Arc::new(ModelLease),
+            ),
+        ))
+    }
+
+    fn start(&self, _: StartExecution) -> BoxFuture<'_, Result<StartedExecution, GatewayError>> {
+        panic!("原生 Images 不能进入 Responses 执行")
+    }
+
+    fn start_provider_endpoint(
+        &self,
+        request: StartProviderExecution,
+    ) -> BoxFuture<'_, Result<StartedExecution, GatewayError>> {
+        Box::pin(async move {
+            assert_eq!(request.provider.as_str(), "openai");
+            assert_eq!(request.metadata.endpoint, "/v1/images/generations");
+            assert_eq!(
+                request.metadata.transport,
+                gateway_core::engine::execution::ClientTransport::HttpJson
+            );
+            let gateway_core::operation::Operation::GenerateImage(image) = request.operation else {
+                panic!("原生 Images 必须保留 GenerateImage operation")
+            };
+            assert_eq!(
+                image.kind(),
+                gateway_core::operation::ImageRequestKind::Generation
+            );
+            self.captured
+                .lock()
+                .unwrap()
+                .push(image.payload().body().clone());
+            self.turn_ids.lock().unwrap().push(
+                image
+                    .payload()
+                    .context()
+                    .get("image_turn_id")
+                    .and_then(serde_json::Value::as_str)
+                    .expect("原生生图必须有稳定 turn ID")
