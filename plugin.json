{
  "manifestVersion": 2,
  "publisher": "community",
  "name": "codex-image-bridge",
  "displayName": "Codex Image Bridge",
  "version": "0.8.1",
  "description": "Codex Image Bridge: immediate image workbench, Responses and native Images debugger, local-day quota accounting and manual calibration.",
  "license": "Apache-2.0",
  "engines": {
    "codex-proxy-rs": ">=3.33.0, <4.0.0"
  },
  "main": "cpr-image-bridge",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "version": 6,
      "stages": [
        "http",
        "request"
      ],
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "scheduler": {
      "version": 3
    },
    "management": {
      "version": 2
    },
    "maintenance": {
      "version": 1
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "driverModel": {
        "type": "string",
        "title": "Responses 对话主控模型",
        "description": "用于驱动 image_generation 工具调用的对话模型 ID，例如 gpt-5.6-luna。需要当前客户端 Key 可以调用。不是图片模型 ID。",
        "default": "gpt-5.6-luna",
        "minLength": 1,
        "maxLength": 128
      },
      "bridgeMode": {
        "type": "string",
        "title": "生图路由策略",
        "description": "控制外部 Images HTTP：auto 优先使用原生 Images，responses 使用 image_generation 工具。画图页使用 Responses；调试页可选择原生 Images，但需配套 Core 管理桥。原生调试不受此兼容转换开关影响。",
        "enum": [
          "auto",
          "responses"
        ],
        "default": "auto"
      },
      "timeoutMs": {
        "type": "integer",
        "title": "图片请求超时（毫秒）",
        "description": "Responses 桥接与画图测试页的单次请求超时。最终超时还受宿主及反代限制。",
        "minimum": 30000,
        "maximum": 600000,
        "default": 300000
      },
      "imageAccountIds": {
        "type": "array",
        "title": "允许生图的账号 ID",
        "description": "只有被宿主选为有效候选且属于本白名单或指定分组的 OpenAI 账号才可执行生图；与分组取并集。空列表不额外放行。",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxItems": 256,
        "uniqueItems": true,
        "default": []
      },
      "imageGroupIds": {
        "type": "array",
        "title": "允许生图的分组 ID",
        "description": "从 CPR 已授权账号候选中选择具有这些分组成员资格的账号，不能扩大当前 Client Key 的权限。与账号白名单取并集。",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxItems": 256,
        "uniqueItems": true,
        "default": []
      },
      "imageModels": {
        "type": "array",
        "title": "对外提供的生图模型",
        "description": "图片模型允许列表，必须为 gpt-image-*。仅这些模型会按当前 Key 和账号/分组范围过滤后出现在 /v1/models。可在插件画图测试页生成完整 JSON 配置。",
        "items": {
          "type": "string",
          "minLength": 11,
          "maxLength": 128,
          "pattern": "^gpt-image-[A-Za-z0-9_.-]+$"
        },
        "maxItems": 32,
        "uniqueItems": true,
        "default": [
          "gpt-image-2.6-sunburst",
          "gpt-image-2.6-flare",
          "gpt-image-2.5-sunburst",
          "gpt-image-2.5-flare",
          "gpt-image-2.5-sunburst-2026-09-08",
          "gpt-image-2.5-flare-2026-09-08",
          "gpt-image-2",
          "gpt-image-1.5"
        ]
      },
      "imageStorageDir": {
        "type": "string",
        "title": "旧版图片路径（兼容项）",
        "description": "只用于读取旧后台任务图片。留空时读取系统临时目录 cpr-image-bridge/images；新生图保存在当前页面，关闭前请保存图片。",
        "maxLength": 1024,
        "default": ""
      },
      "backgroundConcurrency": {
        "type": "integer",
        "title": "旧版整体并发（兼容项）",
        "description": "保留旧配置值；后台生图已停用，此项不再参与调度。页面并发可设 1–4，账号并发由 CPR Core 控制。",
        "minimum": 1,
        "maximum": 64,
        "default": 2
      },
      "dailyTimezone": {
        "type": "string",
        "title": "每日费用记账时区",
        "description": "IANA 时区，例如 UTC、Asia/Shanghai、America/Toronto。按当地自然日归属请求开始时间并处理夏令时；改变时区会清除旧时区的手工校准，原始费用记录保持不变。",
        "minLength": 1,
        "maxLength": 128,
        "default": "UTC"
      },
      "quotaGuard": {
        "type": "array",
        "title": "额度保护账号规则",
        "description": "账号 5 小时/每周额度与每日已记录 USD 费用保护，覆盖该账号全部 CPR 调度请求；与生图账号过滤在同一个 scheduler 内执行。禁用旧 quota-guard 的 scheduler 绑定以防重叠。",
        "maxItems": 1000,
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accountId"
          ],
          "properties": {
            "accountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "fiveHourLimitPercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "default": 95
            },
            "weeklyLimitPercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "default": 95
            },
            "dailyLimitUsd": {
              "type": ["string", "null"],
              "title": "每日已记录费用上限（USD）",
              "description": "默认关闭。覆盖该账号全部 CPR 请求，按 dailyTimezone 当地自然日重置。精确十进制字符串，0 立即阻止。只在当天已知费用（含有效手工校准）达到阈值时拦截，未知或过期观测不单独阻止；并发与记账延迟可能使最终费用超过阈值。",
              "pattern": "^[0-9]{1,18}(\\.[0-9]{1,12})?$",
              "default": null
            },
            "dailyCalibration": {
              "type": ["object", "null"],
              "title": "本日手工费用校准",
              "description": "通过额度管理页设置；服务器记录生效时刻和日窗口。校准金额加上此后新发起请求的费用，本日结束后失效。",
              "default": null,
              "additionalProperties": false,
              "required": ["amountUsd", "atMs", "windowStartMs", "windowEndMs", "timezone"],
              "properties": {
                "amountUsd": { "type": "string", "pattern": "^[0-9]{1,18}(\\.[0-9]{1,12})?$" },
                "atMs": { "type": "integer", "minimum": 0 },
                "windowStartMs": { "type": "integer", "minimum": 0 },
                "windowEndMs": { "type": "integer", "minimum": 0 },
                "timezone": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            }
          }
        }
      },
      "maxObservationAgeSeconds": {
        "type": "integer",
        "title": "额度观测有效期（秒）",
        "description": "超过有效期提示更新；缺失或过期观测不单独拦截，已确认同一窗口超限保留至重置。",
        "minimum": 60,
        "maximum": 86400,
        "default": 300
      },
      "concurrencyPerAccount": {
        "type": "integer",
        "title": "旧版每账号并发（兼容项）",
        "description": "保留旧配置值；后台生图已停用，此项不再参与调度。画图测试页最多 4 个同时请求，账号实际并发由 CPR Core 租约控制。",
        "minimum": 1,
        "maximum": 32,
        "default": 8
      }
    },
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "web/image-client.js": "text/javascript",
    "web/debug.html": "text/html",
    "web/debug.js": "text/javascript",
    "web/debug.css": "text/css",
    "web/quota/index.html": "text/html",
    "web/quota/assets/app.js": "application/javascript",
    "web/quota/assets/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "image-workbench",
      "schemaVersion": 2,
      "schema": {
        "type": "object",
        "required": [
          "clientKeyId",
          "driverModel",
          "imageModel",
          "size",
          "quality",
          "count",
          "parallelism"
        ],
        "properties": {
          "clientKeyId": {
            "type": "string",
            "maxLength": 256
          },
          "driverModel": {
            "type": "string",
            "maxLength": 128
          },
          "imageModel": {
            "type": "string",
            "maxLength": 128
          },
          "size": {
            "type": "string",
            "maxLength": 32
          },
          "quality": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "parallelism": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 4096,
      "maximumValueBytes": 2048,
      "migratesFrom": [
        1
      ]
    },
    {
      "namespace": "image-jobs",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 250000,
      "migratesFrom": []
    }
  ]
}
